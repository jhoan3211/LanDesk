#include <winres.h>
#include "../src/resource.h"

IDI_LANCAST ICON "lancast.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LANCAST_VERSION_MAJOR,LANCAST_VERSION_MINOR,LANCAST_VERSION_PATCH,0
 PRODUCTVERSION LANCAST_VERSION_MAJOR,LANCAST_VERSION_MINOR,LANCAST_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "CompanyName", "LanCast"
            VALUE "FileDescription", "LanCast - escritorio remoto y streaming por LAN"
            VALUE "FileVersion", LANCAST_VERSION
            VALUE "InternalName", "LanCast"
            VALUE "OriginalFilename", "LanCast.exe"
            VALUE "ProductName", "LanCast"
            VALUE "ProductVersion", LANCAST_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0xc0a, 1200
    END
END
